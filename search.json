---
layout: null
permalink: /search.json
---

[
{% assign first_item = true %}

{% for post in site.posts %}

  {% capture post_terms %}{{ post.categories | join: " " }} {{ post.topics | join: " " }} {{ post.section }}{% endcapture %}

  {% unless first_item %},{% endunless %}

  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "type": "Article",
    "date": {{ post.date | date: "%B %-d, %Y" | jsonify }},
    "timestamp": {{ post.date | date: "%s" | jsonify }},
    "categories": {{ post_terms | strip | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | jsonify }}
  }

  {% assign first_item = false %}

{% endfor %}


{% for page in site.pages %}

  {% if page.layout == "page" or page.layout == "hub" or page.layout == "pathway-catalog" or page.layout == "learning-path" %}

    {% unless page.search_exclude %}

      {% unless first_item %},{% endunless %}

      {% assign page_hub = nil %}
      {% assign indexed_pathway = nil %}
      {% for nav_item in site.data.navigation.main %}
        {% if nav_item.key == page.section_key %}
          {% assign page_hub = nav_item %}
        {% endif %}
      {% endfor %}

      {% if page.pathway_key %}
        {% assign indexed_pathway = site.data.learning_paths | where: "slug", page.pathway_key | first %}
      {% endif %}

      {% capture page_terms %}
        {{ page.topics | join: " " }} {{ page.section }} {{ page.section_key }}
        {% if page_hub %}
          {% for child in page_hub.children %}{{ child.title }} {% endfor %}
        {% endif %}
        {% if indexed_pathway %}
          {{ indexed_pathway.level }} {{ indexed_pathway.prerequisite_summary }}
          {% for reading in indexed_pathway.readings %}{{ reading.title }} {{ reading.author }} {% endfor %}
          {% for lecture in indexed_pathway.lectures %}{{ lecture.title }} {% endfor %}
          {% for entry in indexed_pathway.glossary %}{{ entry.term }} {% endfor %}
        {% endif %}
      {% endcapture %}

      {% capture page_search_content %}
        {{ page.content }}
        {% if indexed_pathway %}
          {{ indexed_pathway.introduction }} {{ indexed_pathway.summary }}
          {% for outcome in indexed_pathway.outcomes %}{{ outcome }} {% endfor %}
          {% for question in indexed_pathway.questions %}{{ question }} {% endfor %}
          {% for entry in indexed_pathway.glossary %}{{ entry.term }} {{ entry.definition }} {% endfor %}
        {% endif %}
      {% endcapture %}

      {
        "title": {{ page.title | jsonify }},
        "url": {{ page.url | relative_url | jsonify }},
        "type": {% if page.layout == "hub" %}"Section"{% elsif page.layout == "learning-path" %}"Learning Path"{% elsif page.layout == "pathway-catalog" %}"Learning Catalog"{% else %}"Page"{% endif %},
        "date": "",
        "timestamp": "0",
        "categories": {{ page_terms | strip | jsonify }},
        "excerpt": {{ page.description | default: "" | jsonify }},
        "content": {{ page_search_content | strip_html | strip_newlines | jsonify }}
      }

      {% assign first_item = false %}

    {% endunless %}

  {% endif %}

{% endfor %}

]
