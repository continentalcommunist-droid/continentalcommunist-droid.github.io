{
  "name": "continental-communist-site",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:background && ruby scripts/validate_learning_schema.rb && ruby scripts/build_site.rb build",
    "import:marx": "node scripts/import_mia_texts.mjs",
    "check:marx-import": "node scripts/import_mia_texts.mjs --check",
    "validate:texts": "node scripts/validate_text_library.mjs",
    "validate:learner": "ruby scripts/validate_learner_platform.rb",
    "validate:learning-schema": "ruby scripts/validate_learning_schema.rb",
    "test:lessons": "node --test scripts/test_lessons.mjs",
    "performance:ci": "node scripts/run_lighthouse.mjs",
    "performance:crux": "ruby scripts/check_crux.rb",
    "validate:formatting": "ruby scripts/validate_formatting.rb",
    "build:background": "node scripts/build_background.mjs",
    "test:background": "node --test scripts/test_background.mjs"
  },
  "devDependencies": {
    "cheerio": "^1.1.2",
    "chrome-launcher": "1.2.1",
    "esbuild": "0.28.2",
    "lighthouse": "13.4.1"
  },
  "dependencies": {
    "ogl": "1.0.11"
  }
}
