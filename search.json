---
layout: null
permalink: /search.json
---

[
{% assign first_item = true %}

{% for post in site.posts %}

  {% capture post_terms %}
    {{ post.topics | join: " " }}
    {{ post.section }} {{ post.content_type }} {{ post.author }}
    {{ post.thinkers | join: " " }} {{ post.people | join: " " }}
    {{ post.region | join: " " }} {{ post.historical_period | join: " " }}
    {{ post.reading_level }} {{ post.languages | join: " " }}
  {% endcapture %}

  {% unless first_item %},{% endunless %}

  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "type": {{ post.content_type | default: "Article" | jsonify }},
    "date": {{ post.date | date: "%B %-d, %Y" | jsonify }},
    "timestamp": {{ post.date | date: "%s" | jsonify }},
    "categories": {{ post_terms | strip | jsonify }},
    "excerpt": {{ post.description | default: post.excerpt | strip_html | strip_newlines | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | jsonify }},
    "content_type": {{ post.content_type | default: "Article" | jsonify }},
    "topic": {{ post.topics | jsonify }},
    "author": {{ post.author | default: site.author | jsonify }},
    "thinker": {{ post.thinkers | default: post.people | jsonify }},
    "geographic_region": {{ post.region | jsonify }},
    "historical_period": {{ post.historical_period | jsonify }},
    "difficulty": {{ post.reading_level | jsonify }},
    "format": "Article",
    "language": {{ post.languages | default: post.language | default: "English" | jsonify }}
  }

  {% assign first_item = false %}

{% endfor %}


{% for page in site.pages %}

  {% if page.layout == "page" or page.layout == "hub" or page.layout == "pathway-catalog" %}

    {% unless page.search_exclude %}

      {% unless first_item %},{% endunless %}

      {% assign page_hub = nil %}
      {% for nav_item in site.data.navigation.main %}
        {% if nav_item.key == page.section_key %}
          {% assign page_hub = nav_item %}
        {% endif %}
      {% endfor %}

      {% capture page_terms %}
        {{ page.topics | join: " " }} {{ page.section }} {{ page.section_key }}
        {{ page.thinkers | join: " " }} {{ page.people | join: " " }}
        {{ page.region | join: " " }} {{ page.historical_period | join: " " }}
        {% if page_hub %}
          {% for child in page_hub.children %}{{ child.title }} {% endfor %}
        {% endif %}
      {% endcapture %}

      {% if page.layout == "hub" %}
        {% assign page_type = "Section" %}
        {% assign page_format = "Section hub" %}
      {% elsif page.layout == "pathway-catalog" %}
        {% assign page_type = "Learning Catalog" %}
        {% assign page_format = "Catalog" %}
      {% else %}
        {% assign page_type = page.content_type | default: "Page" %}
        {% assign page_format = "Page" %}
      {% endif %}

      {
        "title": {{ page.title | jsonify }},
        "url": {{ page.url | relative_url | jsonify }},
        "type": {{ page_type | jsonify }},
        "date": "",
        "timestamp": "0",
        "categories": {{ page_terms | strip | jsonify }},
        "excerpt": {{ page.description | default: "" | jsonify }},
        "content": {{ page.content | strip_html | strip_newlines | jsonify }},
        "content_type": {{ page_type | jsonify }},
        "topic": {{ page.topics | jsonify }},
        "author": {{ page.author | default: site.author | jsonify }},
        "thinker": {{ page.thinkers | default: page.people | jsonify }},
        "geographic_region": {{ page.region | jsonify }},
        "historical_period": {{ page.historical_period | jsonify }},
        "difficulty": {{ page.reading_level | default: page.level | jsonify }},
        "format": {{ page_format | jsonify }},
        "language": {{ page.languages | default: page.language | default: "English" | jsonify }}
      }

      {% assign first_item = false %}

    {% endunless %}

  {% endif %}

{% endfor %}


{% assign cms_documents = site.briefs %}
{% assign cms_documents = cms_documents | concat: site.courses %}
{% assign cms_documents = cms_documents | concat: site.lessons %}
{% assign cms_documents = cms_documents | concat: site.reading_paths %}
{% assign cms_documents = cms_documents | concat: site.books %}
{% assign cms_documents = cms_documents | concat: site.people %}
{% assign cms_documents = cms_documents | concat: site.concepts %}
{% assign cms_documents = cms_documents | concat: site.topics %}
{% assign cms_documents = cms_documents | concat: site.events %}
{% assign cms_documents = cms_documents | concat: site.podcasts %}

{% for document in cms_documents %}

  {% unless document.search_exclude %}

    {% unless first_item %},{% endunless %}

    {% assign document_type = document.content_type | default: "Page" %}
    {% assign document_topic = document.topics %}
    {% if document_type == "Topic" %}
      {% assign document_topic = document.name | default: document.title %}
    {% endif %}

    {% assign document_author = document.author | default: document.authors | default: document.instructors %}
    {% assign document_thinker = document.thinkers | default: document.people %}
    {% assign document_difficulty = document.reading_level | default: document.level %}
    {% assign document_language = document.languages | default: document.language | default: "English" %}
    {% assign document_has_publication_date = false %}
    {% if document_type == "Brief" or document_type == "Podcast" %}
      {% assign document_has_publication_date = true %}
    {% endif %}

    {% case document_type %}
      {% when "Brief" %}{% assign document_format = "Briefing" %}
      {% when "Course" %}{% assign document_format = "Course" %}
      {% when "Lesson" %}{% assign document_format = "Lesson" %}
      {% when "Learning Path" %}{% assign document_format = "Guided pathway" %}
      {% when "Book / Text" %}{% assign document_format = document.text_type | default: "Text" %}
      {% when "Person" %}{% assign document_format = "Profile" %}
      {% when "Concept" %}{% assign document_format = "Glossary" %}
      {% when "Topic" %}{% assign document_format = "Topic guide" %}
      {% when "Event" %}{% assign document_format = document.format_type | default: "Event" %}
      {% when "Podcast" %}{% assign document_format = "Audio" %}
      {% else %}{% assign document_format = "Page" %}
    {% endcase %}

    {% capture document_terms %}
      {{ document_topic | join: " " }}
      {{ document.region | join: " " }}
      {{ document.historical_period | join: " " }}
      {{ document.section_key }} {{ document_type }} {{ document_format }}
      {{ document.level }} {{ document.reading_level }}
      {{ document_author | join: " " }} {{ document.editor }}
      {{ document_thinker | join: " " }} {{ document_language | join: " " }}
      {{ document.synonyms | join: " " }} {{ document.aliases | join: " " }}
      {{ document.parent }} {{ document.related_topics | join: " " }}
      {% for reading in document.readings %}{{ reading.title }} {{ reading.author }} {% endfor %}
      {% for lecture in document.lectures %}{{ lecture.title }} {% endfor %}
      {% for entry in document.glossary %}{{ entry.term }} {% endfor %}
    {% endcapture %}

    {% capture document_search_content %}
      {{ document.content }} {{ document.introduction }} {{ document.summary }}
      {% for outcome in document.outcomes %}{{ outcome }} {% endfor %}
      {% for question in document.questions %}{{ question }} {% endfor %}
      {% for entry in document.glossary %}{{ entry.term }} {{ entry.definition }} {% endfor %}
    {% endcapture %}

    {
      "title": {{ document.title | jsonify }},
      "url": {{ document.url | relative_url | jsonify }},
      "type": {{ document_type | jsonify }},
      "date": {% if document_has_publication_date and document.date %}{{ document.date | date: "%B %-d, %Y" | jsonify }}{% else %}""{% endif %},
      "timestamp": {% if document_has_publication_date and document.date %}{{ document.date | date: "%s" | jsonify }}{% else %}"0"{% endif %},
      "categories": {{ document_terms | strip | jsonify }},
      "excerpt": {{ document.description | default: document.summary | default: "" | jsonify }},
      "content": {{ document_search_content | strip_html | strip_newlines | jsonify }},
      "content_type": {{ document_type | jsonify }},
      "topic": {{ document_topic | jsonify }},
      "author": {{ document_author | jsonify }},
      "thinker": {{ document_thinker | jsonify }},
      "geographic_region": {{ document.region | jsonify }},
      "historical_period": {{ document.historical_period | jsonify }},
      "difficulty": {{ document_difficulty | jsonify }},
      "format": {{ document_format | jsonify }},
      "language": {{ document_language | jsonify }}
    }

    {% assign first_item = false %}

  {% endunless %}

{% endfor %}

]
