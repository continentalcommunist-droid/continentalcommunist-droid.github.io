---
layout: null
permalink: /search.json
---

[
{% assign first_item = true %}

{% for post in site.posts %}

  {% capture post_terms %}{{ post.categories | join: " " }} {{ post.topics | join: " " }} {{ post.section }}{% endcapture %}

  {% unless first_item %},{% endunless %}

  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "type": "Article",
    "date": {{ post.date | date: "%B %-d, %Y" | jsonify }},
    "timestamp": {{ post.date | date: "%s" | jsonify }},
    "categories": {{ post_terms | strip | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | jsonify }}
  }

  {% assign first_item = false %}

{% endfor %}


{% for page in site.pages %}

  {% if page.layout == "page" or page.layout == "hub" %}

    {% unless page.search_exclude %}

      {% unless first_item %},{% endunless %}

      {% assign page_hub = nil %}
      {% for nav_item in site.data.navigation.main %}
        {% if nav_item.key == page.section_key %}
          {% assign page_hub = nav_item %}
        {% endif %}
      {% endfor %}

      {% capture page_terms %}
        {{ page.topics | join: " " }} {{ page.section }} {{ page.section_key }}
        {% if page_hub %}
          {% for child in page_hub.children %}{{ child.title }} {% endfor %}
        {% endif %}
      {% endcapture %}

      {
        "title": {{ page.title | jsonify }},
        "url": {{ page.url | relative_url | jsonify }},
        "type": {% if page.layout == "hub" %}"Section"{% else %}"Page"{% endif %},
        "date": "",
        "timestamp": "0",
        "categories": {{ page_terms | strip | jsonify }},
        "excerpt": {{ page.description | default: "" | jsonify }},
        "content": {{ page.content | strip_html | strip_newlines | jsonify }}
      }

      {% assign first_item = false %}

    {% endunless %}

  {% endif %}

{% endfor %}

]
